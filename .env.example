# Ces 6 cles sont pour le developpement local (docker-compose.yml, Vault dev-mode).
DB_PASSWORD=change-me
JWT_SECRET=change-me-base64-encoded-32-bytes-minimum
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-12-chars
VAULT_DEV_ROOT_TOKEN=change-me-dev-only-token
GRAFANA_ADMIN_PASSWORD=change-me

# Sur la VM Azure (docker-compose.azure.yml), le .env ne contient plus que des
# valeurs non sensibles : DB_PASSWORD/JWT_SECRET/ADMIN_EMAIL/ADMIN_PASSWORD
# viennent d'Azure Key Vault, plus besoin de les stocker sur la VM.
# ACR_LOGIN_SERVER=xxx.azurecr.io
# IMAGE_TAG=latest
# PG_FLEXIBLE_SERVER_FQDN=xxx.postgres.database.azure.com
# DB_USERNAME=incident
# AZURE_KEY_VAULT_URI=https://xxx.vault.azure.net/
# GRAFANA_ADMIN_PASSWORD=change-me
